-- 送信処理関数
local function sendFeedback(message)
	if message == "" then
		StarterGui:SetCore("SendNotification", {Title="送信失敗", Text="内容を入力してください", Duration=2})
		return
	end
	local data = {
		playerName = player.Name,
		playerId = player.UserId,
		message = message
	}
	local success, err = pcall(function()
		HttpService:PostAsync(HOOK_URL, HttpService:JSONEncode(data), Enum.HttpContentType.ApplicationJson)
	end)
	if success then
		fbBox.Text = ""
		StarterGui:SetCore("SendNotification", {Title="送信完了", Text="フィードバックを送信しました", Duration=3})
	else
		StarterGui:SetCore("SendNotification", {Title="送信エラー", Text="送信に失敗しました: "..tostring(err), Duration=3})
	end
end

sendBtn.MouseButton1Click:Connect(function()
	sendFeedback(fbBox.Text)
end)

--==============================
-- キャラクター強化
--==============================
local function apply(char)
	local hum = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")

	hum.WalkSpeed = 200
	hum.JumpPower = 150

	UIS.JumpRequest:Connect(function()
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end)

	UIS.InputBegan:Connect(function(input, gpe)
		if gpe then return end

		if input.KeyCode == Enum.KeyCode.C then
			local nc = root:FindFirstChild("NoclipConn")
			if not nc then
				local conn = RunService.Stepped:Connect(function()
					for _, p in pairs(char:GetDescendants()) do
						if p:IsA("BasePart") then
							p.CanCollide = false
						end
					end
				end)
				conn.Name = "NoclipConn"
				conn.Parent = root
				StarterGui:SetCore("SendNotification",{Title="Noclip";Text="ON";Duration=2})
			else
				nc:Disconnect()
				nc:Destroy()
				StarterGui:SetCore("SendNotification",{Title="Noclip";Text="OFF";Duration=2})
			end
		end

		if input.KeyCode == Enum.KeyCode.E then
			StarterGui:SetCore("SendNotification",{Title="お知らせ";Text="Flyは現在メンテナンス中です";Duration=3})
		end

		if input.KeyCode == Enum.KeyCode.F then
			if setclipboard then
				setclipboard("https://discord.gg/Ax9yJDR6sV")
			end
			StarterGui:SetCore("SendNotification",{Title="Discord";Text="招待リンクコピー完了！";Duration=3})
		end
	end)
end

if player.Character then apply(player.Character) end
player.CharacterAdded:Connect(apply)

