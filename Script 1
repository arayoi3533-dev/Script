-- ===============================
-- 🦊 Foxname 移動ハブ（最終完全版）
-- 移動 / ジャンプ / 無限ジャンプ / すり抜け
-- 保存テレポート（自動更新）
-- プレイヤー名クリックTP（自動更新）
-- ===============================

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

-- サービス
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- ===============================
-- 🪟 ウィンドウ
-- ===============================
local Window = Rayfield:CreateWindow({
    Name = "🦊 Foxname",
    LoadingTitle = "Foxname 起動中",
    LoadingSubtitle = "移動強化ハブ",
    ConfigurationSaving = { Enabled = false }
})

-- ===============================
-- ⚙️ 変数
-- ===============================
local speedOn, jumpOn, infJumpOn, noclipOn = false, false, false, false
local walkSpeed, jumpPower = 200, 150
local noclipConnection

getgenv().SavedTeleports = getgenv().SavedTeleports or {}
local TPName = ""
local savedTPButtons = {}

-- ===============================
-- 🔄 キャラ反映
-- ===============================
local function applyCharacter()
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.WalkSpeed = speedOn and walkSpeed or 16
    hum.JumpPower = jumpOn and jumpPower or 50
end

player.CharacterAdded:Connect(function()
    task.wait(0.5)
    applyCharacter()
end)

-- ===============================
-- 🚀 移動タブ
-- ===============================
local MoveTab = Window:CreateTab("🚀 移動", 4483362458)

MoveTab:CreateToggle({
    Name = "🏃 移動速度アップ",
    Callback = function(v)
        speedOn = v
        applyCharacter()
    end
})

MoveTab:CreateSlider({
    Name = "⚡ 移動速度",
    Range = {16, 500},
    Increment = 10,
    CurrentValue = walkSpeed,
    Callback = function(v)
        walkSpeed = v
        if speedOn then applyCharacter() end
    end
})

MoveTab:CreateToggle({
    Name = "🦘 ジャンプ強化",
    Callback = function(v)
        jumpOn = v
        applyCharacter()
    end
})

MoveTab:CreateSlider({
    Name = "⬆️ ジャンプ力",
    Range = {50, 500},
    Increment = 10,
    CurrentValue = jumpPower,
    Callback = function(v)
        jumpPower = v
        if jumpOn then applyCharacter() end
    end
})

MoveTab:CreateToggle({
    Name = "♾️ 無限ジャンプ",
    Callback = function(v)
        infJumpOn = v
    end
})

UserInputService.JumpRequest:Connect(function()
    if infJumpOn then
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- ===============================
-- 👻 すり抜け
-- ===============================
MoveTab:CreateToggle({
    Name = "👻 壁すり抜け",
    Callback = function(v)
        if noclipConnection then noclipConnection:Disconnect() end
        if v then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = player.Character
                if not char then return end
                for _, p in pairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CanCollide = false
                    end
                end
            end)
        end
    end
})

-- ===============================
-- 🌀 保存テレポート（自動更新）
-- ===============================
local TPTab = Window:CreateTab("🌀 テレポート", 4483362458)
TPTab:CreateSection("📍 保存")

TPTab:CreateInput({
    Name = "📛 保存名",
    PlaceholderText = "例：拠点 / ロビー",
    RemoveTextAfterFocusLost = false,
    Callback = function(text)
        TPName = text
    end
})

-- 一覧クリア
local function ClearSavedTP()
    for _, b in pairs(savedTPButtons) do
        if b then b:Destroy() end
    end
    table.clear(savedTPButtons)
end

-- 一覧生成
local function RefreshSavedTP()
    ClearSavedTP()
    for name, cf in pairs(getgenv().SavedTeleports) do

        local tpBtn = TPTab:CreateButton({
            Name = "🌀 "..name,
            Callback = function()
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.CFrame = cf end
            end
        })

        local delBtn = TPTab:CreateButton({
            Name = "🗑️ 削除 : "..name,
            Callback = function()
                getgenv().SavedTeleports[name] = nil
                RefreshSavedTP()
            end
        })

        table.insert(savedTPButtons, tpBtn)
        table.insert(savedTPButtons, delBtn)
    end
end

-- 保存
TPTab:CreateButton({
    Name = "💾 現在地を保存",
    Callback = function()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp or TPName == "" then return end
        getgenv().SavedTeleports[TPName] = hrp.CFrame
        RefreshSavedTP()
    end
})

RefreshSavedTP()

-- ===============================
-- 👥 プレイヤー名クリックTP（自動更新）
-- ===============================
local PlayerTab = Window:CreateTab("👥 プレイヤー", 4483362458)
PlayerTab:CreateSection("🖱️ クリックでテレポート")

local playerButtons = {}

local function ClearPlayers()
    for _, b in pairs(playerButtons) do
        if b then b:Destroy() end
    end
    table.clear(playerButtons)
end

local function RefreshPlayers()
    ClearPlayers()
    for _, target in pairs(Players:GetPlayers()) do
        if target ~= player then
            local btn = PlayerTab:CreateButton({
                Name = "👤 "..target.Name,
                Callback = function()
                    local myHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    local tHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                    if myHRP and tHRP then
                        myHRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, -3)
                    end
                end
            })
            table.insert(playerButtons, btn)
        end
    end
end

RefreshPlayers()

Players.PlayerAdded:Connect(function()
    task.wait(0.3)
    RefreshPlayers()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.2)
    RefreshPlayers()
end)

-- ===============================
-- ✅ 起動通知
-- ===============================
Rayfield:Notify({
    Title = "🦊 Foxname",
    Content = "最終完全版 起動完了",
    Duration = 3
})
