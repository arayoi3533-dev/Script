-- 最終まとめ版 強化ハブ
-- パス: jsokkzwa | Flyメンテ中

local pass = "jsokkzwa"

local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer

--==============================
-- パスワード認証GUI
--==============================
local sg = Instance.new("ScreenGui", game.CoreGui)
local tb = Instance.new("TextBox", sg)
tb.Size = UDim2.new(0, 300, 0, 60)
tb.Position = UDim2.new(0.5, -150, 0.5, -30)
tb.PlaceholderText = "パスワード入力 (jsokkzwa)"
tb.BackgroundColor3 = Color3.fromRGB(30,30,30)
tb.TextColor3 = Color3.new(1,1,1)
tb.Font = Enum.Font.GothamBold
tb.TextSize = 24
tb.ClearTextOnFocus = false

local auth = false
tb.FocusLost:Connect(function(enter)
	if not enter then return end
	if tb.Text == pass then
		auth = true
		sg:Destroy()
	else
		tb.Text = ""
		StarterGui:SetCore("SendNotification", {
			Title = "認証失敗",
			Text = "パスワードが違います",
			Duration = 3
		})
	end
end)

repeat task.wait() until auth

--==============================
-- キャラクター強化
--==============================
local function apply(char)
	local hum = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")

	hum.WalkSpeed = 200
	hum.JumpPower = 150

	-- 無限ジャンプ
	UIS.JumpRequest:Connect(function()
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end)

	-- キー操作
	UIS.InputBegan:Connect(function(input, gpe)
		if gpe then return end

		-- Noclip (C)
		if input.KeyCode == Enum.KeyCode.C then
			local nc = root:FindFirstChild("NoclipConn")
			if not nc then
				local conn = RunService.Stepped:Connect(function()
					for _, p in pairs(char:GetDescendants()) do
						if p:IsA("BasePart") then
							p.CanCollide = false
						end
					end
				end)
				conn.Name = "NoclipConn"
				conn.Parent = root
				StarterGui:SetCore("SendNotification",{Title="Noclip";Text="ON";Duration=2})
			else
				nc:Disconnect()
				nc:Destroy()
				StarterGui:SetCore("SendNotification",{Title="Noclip";Text="OFF";Duration=2})
			end
		end

		-- Flyメンテ中 (E)
		if input.KeyCode == Enum.KeyCode.E then
			StarterGui:SetCore("SendNotification",{Title="お知らせ";Text="Flyは現在メンテナンス中です";Duration=3})
		end

		-- Discordコピー (F)
		if input.KeyCode == Enum.KeyCode.F then
			if setclipboard then
				setclipboard("https://discord.gg/Ax9yJDR6sV")
			end
			StarterGui:SetCore("SendNotification",{Title="Discord";Text="招待リンクコピー完了！";Duration=3})
		end
	end)
end

-- 初回 & リスポーン対応
if player.Character then apply(player.Character) end
player.CharacterAdded:Connect(apply)

